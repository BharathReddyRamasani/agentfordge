# ============================================================
# AgentForge — Environment Configuration
# Copy this file to .env and fill in the values you need.
# The ONLY required value for local development is nothing:
# safe development defaults exist for everything except the
# LLM API key when you switch LLM_PROVIDER away from "mock".
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=AgentForge
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# Local dev default (no Docker needed): sqlite:///./data/agentforge.db
# Docker Compose / production:
DATABASE_URL=sqlite:///./data/agentforge.db

# --- Redis ---
# Local dev default uses an in-process fallback when unreachable.
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM Provider ---
# mock    -> deterministic offline provider (development/tests, no key needed)
# opencode_zen -> OpenCode Zen gateway (OPENCODE_ZEN_API_KEY)
# openrouter   -> OpenRouter gateway (OPENROUTER_API_KEY + LLM_MODEL)
# nvidia       -> NVIDIA Build / NIM, cloud or self-hosted (NVIDIA_API_KEY)
# openai       -> any OpenAI-compatible API (LLM_API_KEY + LLM_BASE_URL)
# gemini       -> Google Gemini API (LLM_API_KEY)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# --- Provider-specific credentials (env only; never exposed or stored) ---
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=http://localhost:8000
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Explicit multi-provider fallback (empty = fail clearly, never silently switch) ---
LLM_PRIMARY_PROVIDER=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# --- Per-agent model routing (optional, configuration-driven) ---
# Example: LLM_PROVIDER_PLANNING=openrouter
#          LLM_MODEL_REVIEW=nvidia/llama-3.1-70b-instruct
# Suffix = UPPER_SNAKE agent name, e.g. LLM_MODEL_PLANNING_AGENT

# --- Logging ---
LOG_LEVEL=INFO

# --- Database pooling (PostgreSQL; SQLite uses a single connection) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Embeddings / RAG ---
# tfidf  -> local TF-IDF vector embeddings (no external calls)
# openai -> OpenAI embeddings API (requires LLM_API_KEY)
EMBEDDING_PROVIDER=tfidf
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=8

# --- Worker / Execution ---
WORKER_POLL_INTERVAL=2.0
SANDBOX_TIMEOUT=300
MAX_DEBUG_ITERATIONS=3
MAX_AGENT_RETRIES=2
